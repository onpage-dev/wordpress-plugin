#!/bin/sh
# Costruisce lo zip di distribuzione del plugin.
#
#   ./build-zip           dal commit corrente
#   ./build-zip v2.1.0    da un tag, come in un rilascio
#
# Nel pacchetto entra solo cio' che serve a WordPress per far girare il plugin,
# piu' licenza e changelog. E' una allowlist e non una lista di esclusioni: un
# file nuovo dell'ambiente di sviluppo non finisce nello zip per dimenticanza.
# La documentazione per chi integra sta online e non dentro il pacchetto: cosi'
# non spediamo gli interni del plugin a clienti e partner, e non ci sono link
# relativi che si rompono quando si esclude un file.
set -eu

REF="${1:-HEAD}"
cd "$(git rev-parse --show-toplevel)"

git rev-parse --verify --quiet "$REF^{commit}" >/dev/null || {
    echo "ref sconosciuto: $REF" >&2
    exit 1
}

VERSION=$(git show "$REF:onpage.php" | sed -n 's/^ \* Version: *//p' | tr -d ' \r')
[ -n "$VERSION" ] || {
    echo "nessun 'Version:' nell'header di onpage.php in $REF" >&2
    exit 1
}

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# Le cartelle di src/ sono elencate una per una invece di prendere src intero: cosi'
# src/Tests, che parla via HTTP con un sito di prova e non viene mai incluso da
# onpage.php, resta fuori dal pacchetto, e una cartella nuova va aggiunta qui per
# entrarci — che e' esattamente la dimenticanza che l'allowlist deve provocare.
git archive --prefix=onpage/ "$REF" \
    onpage.php routes.php LICENSE CHANGELOG.md \
    src/Env.php src/Router.php src/helpers.php \
    src/Controllers src/Exceptions src/Middlewares src/Services src/Views \
    | tar -x -C "$WORK"

mkdir -p dist
ZIP="$PWD/dist/onpage-$VERSION.zip"
rm -f "$ZIP"
# -X: niente campi extra (timestamp ad alta risoluzione, uid/gid), cosi' due build
# dallo stesso tag producono lo stesso sha256 e l'artefatto e' verificabile
(cd "$WORK" && zip -qrX "$ZIP" onpage)

# controllo: la versione dentro il pacchetto deve essere quella del nome del file
PACKED=$(unzip -p "$ZIP" onpage/onpage.php | sed -n 's/^ \* Version: *//p' | tr -d ' \r')
[ "$PACKED" = "$VERSION" ] || {
    echo "il pacchetto dichiara $PACKED ma si chiama $VERSION" >&2
    exit 1
}

echo "$ZIP"
echo "  ref      $REF"
echo "  versione $VERSION"
echo "  file     $(find "$WORK/onpage" -type f | wc -l | tr -d ' ')"
echo "  sha256   $(shasum -a 256 "$ZIP" | cut -d' ' -f1)"
