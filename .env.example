# Copiare in .env e valorizzare. Il file .env non e' versionato e non entra nel
# pacchetto di distribuzione.
#
# Lo stesso file viene letto da due lettori diversi:
#   - docker compose, per l'ambiente di sviluppo locale: le variabili MYSQL_* e HOST_*
#   - il plugin, tramite OnPage\Env, per le variabili WP_TEST_* usate dai test
#
# ATTENZIONE ai commenti. I due lettori non concordano sulla sintassi: docker compose
# vuole #, mentre PHP vuole ; e tollera # solo finche' il commento resta prosa semplice.
# Se un commento # contiene uno tra questi caratteri
#     parentesi tonde, virgolette doppie, punto esclamativo, e commerciale,
#     barra verticale, dollaro, parentesi graffe, parentesi quadre, tilde
# allora parse_ini_file scarta l'INTERO file e il plugin legge ogni variabile come
# vuota, senza che nulla lo segnali. Tenere i commenti in prosa semplice.
# ./bin/test-launcher controlla questa cosa prima di eseguire i test.


# --- Database dell'ambiente docker locale -------------------------------------

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress


# --- Proprietario dei file montati nel container ------------------------------
# Devono corrispondere a id -u e id -g dell'utente host, altrimenti i file
# scritti da WordPress dentro wp-content non sono modificabili dall'host.

HOST_UID=1000
HOST_GID=1000


# --- Test degli endpoint, cartella src/Tests ----------------------------------
# Usati da ./bin/test-launcher. I test creano e poi cancellano i propri dati:
# puntarli a un sito di prova, mai alla produzione.

# URL base del sito WordPress di prova, senza slash finale.
WP_TEST_URL=http://localhost:8040

# Token Bearer delle API On Page: lo stesso valore salvato nel sito
# nell'opzione WordPress onpage_auth_token.
WP_TEST_TOKEN=
