# Copy to .env and fill in the values. The .env file is not versioned and is not
# part of the distribution package.
#
# The same file is read by two different readers:
#   - docker compose, for the local development environment: the MYSQL_* and HOST_* variables
#   - the tests in src/Tests, through src/Env.php, for the WP_TEST_* variables: the plugin
#     never reads .env in production
#
# BEWARE of comments. The two readers disagree on the syntax: docker compose
# wants #, while PHP wants ; and tolerates # only as long as the comment stays plain prose.
# If a # comment contains any of these characters
#     round brackets, double quotes, exclamation mark, ampersand,
#     vertical bar, dollar sign, curly braces, square brackets, tilde
# then parse_ini_file discards the WHOLE file and the tests read every variable as
# empty, with nothing reporting it. Keep comments in plain prose.
# ./bin/test-launcher checks this before running the tests.


# --- Database of the local docker environment ---------------------------------

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress


# --- Owner of the files mounted in the container ------------------------------
# They must match id -u and id -g of the host user, otherwise the files
# written by WordPress inside wp-content cannot be edited from the host.

HOST_UID=1000
HOST_GID=1000


# --- Endpoint tests, src/Tests folder -----------------------------------------
# Used by ./bin/test-launcher. The tests create and then delete their own data:
# point them at a test site, never at production.

# Base URL of the test WordPress site, without a trailing slash.
WP_TEST_URL=http://localhost:8040

# Bearer token of the On Page API: the same value stored on the site
# in the WordPress option onpage_auth_token.
WP_TEST_TOKEN=
