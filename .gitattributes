# Paths left out of `git archive`, and so of the plugin archive attached to a release (see
# RELEASE.md). Only what the plugin needs at runtime ships, plus the README, LICENSE, SECURITY.md,
# CHANGELOG.md and docs/. The contributor documents (RELEASE.md, CONTRIBUTING.md, AGENTS.md) stay
# in the repository only.

# Tests and the test-only `.env` reader
/src/Tests export-ignore
/src/Env.php export-ignore
/bin export-ignore
/.env.example export-ignore

# Local Docker environment
/docker export-ignore
/docker-compose.yml export-ignore
/Dockerfile export-ignore
/config export-ignore
/start export-ignore
/stop export-ignore
/restart export-ignore

# Repository tooling
/.github export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore

# MD files
/RELEASE.md export-ignore
/CONTRIBUTING.md export-ignore
/AGENTS.md export-ignore
